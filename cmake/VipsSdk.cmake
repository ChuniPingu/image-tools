string(JSON VIPS_VERSION GET "${IMAGE_TOOLS_MANIFEST}" libvips version)
string(JSON VIPS_SDK_URL GET "${IMAGE_TOOLS_MANIFEST}" libvips url)
string(JSON VIPS_SDK_SHA256 GET "${IMAGE_TOOLS_MANIFEST}" libvips sha256)
string(JSON VIPS_SOURCE_URL GET "${IMAGE_TOOLS_MANIFEST}" libvips source)
set(VIPS_ROOT "$ENV{VIPS_ROOT}" CACHE PATH "Extracted matching official libvips web-static SDK (local development override)")
set(VIPS_SDK_OVERRIDE false)
if(VIPS_ROOT)
    get_filename_component(VIPS_SDK_ROOT "${VIPS_ROOT}" ABSOLUTE)
    set(VIPS_SDK_OVERRIDE true)
else()
    set(_sdk_cache "${CMAKE_BINARY_DIR}/_deps/vips-${VIPS_SDK_SHA256}")
    set(_sdk_archive "${_sdk_cache}/sdk.zip")
    set(_sdk_extract "${_sdk_cache}/sdk")
    file(MAKE_DIRECTORY "${_sdk_cache}")
    if(EXISTS "${_sdk_archive}")
        file(SHA256 "${_sdk_archive}" _actual_hash)
        if(NOT _actual_hash STREQUAL VIPS_SDK_SHA256)
            message(FATAL_ERROR "Cached SDK archive checksum mismatch: ${_sdk_archive}")
        endif()
    else()
        message(STATUS "Downloading pinned libvips SDK")
        file(DOWNLOAD "${VIPS_SDK_URL}" "${_sdk_archive}"
            EXPECTED_HASH "SHA256=${VIPS_SDK_SHA256}" TLS_VERIFY ON SHOW_PROGRESS)
    endif()
    string(REGEX REPLACE "\\.[0-9]+$" "" _vips_major_minor "${VIPS_VERSION}")
    set(VIPS_SDK_ROOT "${_sdk_extract}/vips-dev-${_vips_major_minor}")
    if(NOT EXISTS "${VIPS_SDK_ROOT}/versions.json")
        file(ARCHIVE_EXTRACT INPUT "${_sdk_archive}" DESTINATION "${_sdk_extract}")
    endif()
endif()
foreach(_required include/vips/vips.h include/glib-2.0/glib.h
        lib/glib-2.0/include/glibconfig.h bin/libvips-42.dll LICENSE versions.json)
    if(NOT EXISTS "${VIPS_SDK_ROOT}/${_required}")
        message(FATAL_ERROR "Incomplete libvips SDK: missing ${_required} in ${VIPS_SDK_ROOT}")
    endif()
endforeach()
file(READ "${VIPS_SDK_ROOT}/versions.json" _vips_versions)
string(JSON _actual_version GET "${_vips_versions}" vips)
if(NOT _actual_version STREQUAL VIPS_VERSION)
    message(FATAL_ERROR "SDK libvips version ${_actual_version} does not match manifest ${VIPS_VERSION}")
endif()
# Re-resolve after VIPS_ROOT changes, including caches from older build configurations.
unset(VIPS_IMPORT_LIBRARY CACHE)
unset(VIPS_IMPORT_LIBRARY)
find_library(VIPS_IMPORT_LIBRARY NAMES libvips libvips-42
    PATHS "${VIPS_SDK_ROOT}/lib" NO_DEFAULT_PATH NO_CACHE REQUIRED)
set(VIPS_RUNTIME_DLL "${VIPS_SDK_ROOT}/bin/libvips-42.dll")
add_library(Vips::Vips SHARED IMPORTED GLOBAL)
set_target_properties(Vips::Vips PROPERTIES
    IMPORTED_LOCATION "${VIPS_RUNTIME_DLL}"
    IMPORTED_IMPLIB "${VIPS_IMPORT_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${VIPS_SDK_ROOT}/include;${VIPS_SDK_ROOT}/include/glib-2.0;${VIPS_SDK_ROOT}/lib/glib-2.0/include")
